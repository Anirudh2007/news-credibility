# Copy to .env (in this folder or the one above) and fill in. Never commit .env.
#
# The app reads only GOOGLE_FACTCHECK_API_KEY, TAVILY_API_KEY and NEWSCRED_CONTACT from .env itself.
# Docker Compose reads every line. Outside Docker, set the other variables in the shell
# before starting the API, e.g. PowerShell:  $env:EXPLAIN_ENABLED="0"

# Live fact-check lookups. Free key: Google Cloud console, enable "Fact Check Tools API", create an API key.
GOOGLE_FACTCHECK_API_KEY=

# Supporting evidence (2026-11-03). Wikipedia as of the claim date is used in the app only when contact
# details are given (Wikimedia allows 200 requests/min with them, 10/min without): a URL or email.
NEWSCRED_CONTACT=
# NEWSCRED_WIKI_SEARCH=1   # force Wikipedia on without contact details (slow: ~20 s per claim)

# News search of trusted outlets (2026-11-06): confirms true claims, and lets silence count as evidence for
# claims the news would always cover. Free key (1,000 searches a month, no card): https://app.tavily.com
TAVILY_API_KEY=
# NEWSCRED_NEWS_SEARCH=0   # 0 = off; gdelt = GDELT instead of Tavily (free, no key, but often HTTP 429)
# NEWSCRED_EVIDENCE_MEMORY=1   # 0 = do not keep / reuse trusted passages from earlier checks

# Phase 5 explanations: local OpenAI-compatible LLM router (freellmapi).
# Without a reachable router the template explanation is used.
EXPLAIN_BASE_URL=http://localhost:3001/v1
EXPLAIN_MODEL=
EXPLAIN_API_KEY=
EXPLAIN_ENABLED=1

# Optional Hugging Face token (higher download limits for the base models)
HF_TOKEN=

# Other settings, defaults shown.
# 0 = no live fact-check lookups
# NEWSCRED_LIVE_FACTCHECK=1
# 0 = never fetch the article page when only a URL is given
# NEWSCRED_FETCH_URL=1
# Evidence index; models/retrieval_index_india adds Indian fact-checks
# NEWSCRED_RETRIEVAL_DIR=models/retrieval_index
# History and feedback database
# NEWSCRED_DB_URL=sqlite:///data/app.db
# 1 = load every model when the API starts, not on the first request
# NEWSCRED_WARMUP=0
# Where the web app's dev server (frontend/, npm run dev) finds the API
# NEWSCRED_API=http://localhost:8000
# Minimum evidence relevance for a claim verdict to count
# NEWSCRED_RELEVANCE_MIN=0.01
# Claim-match threshold: a fact-check about a different claim does not count
# NEWSCRED_MATCH_MIN=0.55
# Silence as evidence for big claims the news would cover: off by default (fails its target); 0.27 = measured LR
# NEWSCRED_ABSENCE_LR=0.27
# Location check threshold (calibrated on the landmark photos)
# NEWSCRED_LOCATION_MIN=0.49
# Seconds: GDELT timeout, gap between Wikipedia requests (6.5 without NEWSCRED_CONTACT)
# NEWSCRED_NEWS_TIMEOUT=20
# NEWSCRED_WIKI_INTERVAL=0.35
# Lookup caches
# NEWSCRED_FACTCHECK_CACHE=data/cache/factcheck.sqlite
# NEWSCRED_WIKI_CACHE=data/cache/wiki.sqlite
# NEWSCRED_NEWS_CACHE=data/cache/news.sqlite
# NEWSCRED_MEMORY_PATH=data/cache/evidence_memory.sqlite
